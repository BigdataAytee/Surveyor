{
  "name": "@surveyor/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "assistant": "node server/assistant.mjs",
    "smoke:classifier": "node scripts/smoke.mjs --classifier",
    "auth": "node server/auth.mjs",
    "build:auth": "vite build --outDir dist-auth",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "build:offline": "vite build --outDir dist-offline",
    "smoke:offline": "node scripts/smoke-offline.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "smoke:verify": "node scripts/smoke-verify.mjs",
    "build:admin": "vite build --outDir dist-admin"
  },
  "dependencies": {
    "@surveyor/contracts": "0.1.0",
    "@surveyor/engine": "0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "playwright": "^1.50.0",
    "@anthropic-ai/sdk": "^0.70.0"
  }
}
