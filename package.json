{
  "name": "surveyor",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered survey plan drafting agent.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @surveyor/web"
  },
  "license": "UNLICENSED"
}
